EXPO_PUBLIC_DATA_MODE=api
# Defaults to the same Supabase project used by the web app. Override both
# values for a different backend, using only its public publishable key.
# EXPO_PUBLIC_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/api
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional: set only if a compatible HydroSense WebSocket service is deployed.
EXPO_PUBLIC_WS_URL=
