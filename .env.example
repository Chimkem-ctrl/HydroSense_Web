VITE_DATA_MODE=mock
VITE_API_BASE_URL=http://localhost:8000
# Defaults to the WebSocket URL derived from VITE_API_BASE_URL.
# VITE_WS_URL=ws://localhost:8000/ws/v1/stream
VITE_TIER=enterprise
VITE_PILOT_UNLOCK_ALL=true
# Supabase Edge API. VITE_DATA_MODE must be "api".
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# Demo-only administrator credentials for local mock authentication.
VITE_ADMIN_EMAIL=admin@hydrosense.demo
VITE_ADMIN_PASSWORD=AdminDemo!2026

# Expo mobile app (set these in apps/mobile/.env.local).
EXPO_PUBLIC_DATA_MODE=api
# Defaults to the web project's deployed Supabase API and publishable key.
# EXPO_PUBLIC_API_URL=https://YOUR_PROJECT.supabase.co/functions/v1/api
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Set only if a compatible WebSocket service is available.
# EXPO_PUBLIC_WS_URL=ws://localhost:8000/ws/v1/stream
